{
  //Este archivo quita el error de los modules, clases no reconocen su module.css
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },

    "jsx": "react-jsx",
    "moduleResolution": "Bundler",

    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "vite-env.d.ts", "src/types", "global.d.ts"]
}
